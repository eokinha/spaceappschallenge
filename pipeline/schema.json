{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spaceapps2026.local/analogs.schema.json",
  "title": "analogs.json",
  "description": "Contrato entre o pipeline Python e o front-end. Ver docs/instrucoes-desenvolvimento.md, seção 3. A conferência cruzada de ids (links -> analogs/targets) é feita em pipeline/export.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generated_at", "dimensions", "targets", "analogs", "links"],
  "properties": {
    "version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "$ref": "#/$defs/dimensionId" },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "body", "name", "lat", "lon", "description"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "body": { "enum": ["moon", "mars"] },
          "name": { "type": "string", "minLength": 1 },
          "lat": { "$ref": "#/$defs/lat" },
          "lon": { "$ref": "#/$defs/lon" },
          "description": { "type": "string" }
        }
      }
    },
    "analogs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "lat", "lon", "description"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "lat": { "$ref": "#/$defs/lat" },
          "lon": { "$ref": "#/$defs/lon" },
          "description": { "type": "string" }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["analog", "target", "score", "dimensions", "strengths", "limits", "exploration_use", "sources"],
        "properties": {
          "analog": { "$ref": "#/$defs/id" },
          "target": { "$ref": "#/$defs/id" },
          "score": { "$ref": "#/$defs/score" },
          "dimensions": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/dimensionId" },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["score", "earth", "target", "note"],
              "properties": {
                "score": { "$ref": "#/$defs/score" },
                "earth": { "type": "string" },
                "target": { "type": "string" },
                "note": { "type": "string" }
              }
            }
          },
          "strengths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "limits": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "exploration_use": { "type": "string" },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "url"],
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "url": { "type": "string", "format": "uri" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "dimensionId": { "enum": ["gelo", "temperatura", "regolito", "iluminacao", "relevo"] },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "score": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
